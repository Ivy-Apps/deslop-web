{
  "name": "deslop-web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "deslop": "deslop check .",
    "deslop:fix": "deslop fix . && npm run lint:fix",
    "deslop:baseline": "deslop baseline .",
    "check": "npm run typecheck && npm run deslop && npm run lint && npm run build && npm run build-storybook",
    "fix": "npm run deslop:fix"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "lucide-react": "^0.546.0",
    "next": "^16.2.2",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^3.23.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@ivy-apps/deslop": "^0.8.1",
    "@storybook/addon-themes": "^10.4.1",
    "@storybook/nextjs": "^10.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "storybook": "^10.4.1",
    "typescript": "~5.8.2"
  }
}
